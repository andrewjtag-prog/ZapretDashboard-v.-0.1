<Window x:Class="ZapretDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ZapretDashboard.Helpers"
        Title="Zapret Dashboard" Height="700" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#121212"/>
        <SolidColorBrush x:Key="PanelColor" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="TextColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#888888"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFFFFF"/>

        <!-- Стиль для кнопок в списке стратегий -->
        <Style x:Key="TerminalButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для бокового меню (как RadioButton) -->
        <Style x:Key="MenuButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="15,10" Background="Transparent" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- 1. Боковое меню -->
            <ColumnDefinition Width="180" />
            <!-- 2. Основной контент -->
            <ColumnDefinition Width="*" />
            <!-- 3. Панель для гифки (увеличена до 450) -->
            <ColumnDefinition Width="450" />
        </Grid.ColumnDefinitions>

        <!-- БОКОВОЕ МЕНЮ -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="MENU" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="12" Margin="15,0,0,10"/>

            <RadioButton Content="Strategies" Style="{StaticResource MenuButton}" IsChecked="True" Checked="Menu_Strategies"/>
            <RadioButton Content="Services" Style="{StaticResource MenuButton}" Checked="Menu_Services"/>
        </StackPanel>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Секция Стратегий -->
            <Grid x:Name="StrategiesPanel" Grid.Row="0" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Убрана красная строка DebugInfo -->
                        <TextBlock Text="Select Zapret Strategy..." Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Update" Style="{StaticResource TerminalButton}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Strategies}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{StaticResource PanelColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="15">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextColor}" FontSize="15" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource TerminalButton}" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Connect" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Секция Сервисов (изначально скрыта) -->
            <Grid x:Name="ServicesPanel" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DomainInput" Width="250" Background="#222" Foreground="White" BorderBrush="#444" Padding="5" Margin="0,0,10,0" VerticalAlignment="Center" Text="example.com"/>
                        <Button Content="Add Domain" Style="{StaticResource TerminalButton}" Command="{Binding AddServiceCommand}" CommandParameter="{Binding ElementName=DomainInput, Path=Text}"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Services}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{StaticResource PanelColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,5" Padding="10">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Domain}" Foreground="{StaticResource TextColor}" FontSize="15" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Remove" Style="{StaticResource TerminalButton}" Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Нижняя панель статуса -->
            <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="{StaticResource PanelColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF5555"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#55FF55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource TextColor}" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource TerminalButton}" Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ПРАВАЯ ПАНЕЛЬ С ГИФКОЙ (БЕЗ РАМКИ) -->
        <Grid Grid.Column="2" Margin="15,0,0,0">
            <helpers:GifImage GifSource="/Resources/logo.gif" 
                              Stretch="Uniform" 
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</Window>